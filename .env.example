# ---------------------------------------------------------------------------
# Money Flow - environment template
#
# Copy this file, do not edit it in place:
#   cp .env.example .env               # local development
#   cp .env.example .env.production    # production build values
#
# Only VITE_-prefixed variables reach the browser bundle. Anything you put here
# IS PUBLIC once the app is built, so never add a Supabase service_role key,
# database password, or any other server-side secret to this file.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------
# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# The "anon" / publishable key. Safe to ship because Row Level Security is what
# actually protects the data (see supabase/schema.sql).
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Optional -------------------------------------------------------------
# Error tracking. Leave empty to disable Sentry entirely.
# Sentry Dashboard > Project > Settings > Client Keys (DSN)
VITE_SENTRY_DSN=

# Fraction of transactions traced when Sentry is enabled (0 to 1).
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Shown in error reports and the settings screen so you can tell which build a
# report came from. Suggested values: development | staging | production
VITE_APP_ENV=development
